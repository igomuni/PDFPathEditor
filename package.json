{
  "name": "pdf-path-editor",
  "version": "0.0.1",
  "private": true,
  "description": "画像PDFを再編集可能な構造化データ(Path / Text / Image)にするElectronデスクトップツール",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && pnpm test && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "fonts": "node scripts/fetch-fonts.ts",
    "e2e": "node scripts/e2e/smoke.mjs",
    "ocr:build": "mkdir -p resources/bin && swiftc -O native/vision-ocr/main.swift -o resources/bin/vision-ocr"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@tesseract.js-data/jpn": "^1.0.0",
    "fontkit": "^3.0.0",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
